rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isRegisteredOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Existing Anatomy user document stays valid.
    match /users/{userId} {
      allow read: if isRegisteredOwner(userId);

      allow create, update: if isRegisteredOwner(userId)
        && request.resource.data.accountType == 'registered';

      allow delete: if isRegisteredOwner(userId);

      // Subject-specific progress.
      // Histology should write here instead of overwriting users/{uid}.progress.
      match /subjects/{subjectId} {
        allow read, create, update, delete: if isRegisteredOwner(userId)
          && subjectId in ['histology'];
      }
    }
  }
}
